# Copy to .env (or set real environment variables). All values are optional.
PORT=8080
# Where the SQLite database, signing secret and uploaded installers live.
DATA_DIR=./data
# Secret used to sign login tokens. Generated into DATA_DIR/secret.key when unset.
TOKEN_SECRET=
# First admin account, created at startup if no admin exists yet.
# If ADMIN_PASSWORD is empty a random one is generated and printed once.
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
# VSMP server
VSMP_NAME=VSMP
JAVA_HOST=neuron.zeroxhost.space
JAVA_PORT=19145
# Bedrock players (Android). Defaults to the Java host; set the real Bedrock port.
BEDROCK_HOST=neuron.zeroxhost.space
BEDROCK_PORT=19132
DISCORD_URL=
WEBSITE_URL=
# Set to 1 when running behind a reverse proxy (nginx, Caddy, Cloudflare) so client IPs are read from X-Forwarded-For.
TRUST_PROXY=0
# Largest installer upload accepted by the admin panel, in MB.
MAX_UPLOAD_MB=300
